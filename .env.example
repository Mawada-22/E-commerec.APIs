# Copy to ".env" (which is gitignored) and fill in. docker compose reads it automatically.

# SQL Server sa password for the local container. Must meet SQL's complexity rules
# (8+ chars, upper + lower + digit/symbol) or the container exits on startup.
SA_PASSWORD=Your_strong_Passw0rd

# REQUIRED. Signing key for login tokens - generate a long random string, e.g.
#   powershell -c "[Convert]::ToBase64String((1..48|%{Get-Random -Max 256}))"
JWT_SECRET_KEY=

# Password given to the seeded Admin / SuperAdmin accounts.
SEED_USERS_PASSWORD=Ec@Seed0nly1

# Stripe test keys. Leave blank to run without payments (the rest of the shop works).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
